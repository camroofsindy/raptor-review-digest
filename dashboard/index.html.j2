<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Raptor Review Digest | {{ run_date }}</title>
<meta name="description" content="Weekly competitive intelligence for Raptor Roofing in Indianapolis.">
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='45' fill='%23172e55'/%3E%3Ctext x='50' y='62' font-size='40' text-anchor='middle' fill='%233ae20a' font-family='sans-serif' font-weight='700'%3ER%3C/text%3E%3C/svg%3E">

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0"></script>
<script>
tailwind.config = {
  theme: {
    extend: {
      colors: {
        navy: { DEFAULT: '#172e55', deep: '#0d1d3a', light: '#2a4880' },
        accent: { green: '#3ae20a', blue: '#1ac6ff' },
        ink: { DEFAULT: '#172e55', soft: '#4a5568', light: '#9aa5b8' },
      },
      fontFamily: { sans: ['Ouma Latin VF', 'Inter', 'Helvetica Neue', 'Helvetica', 'Arial', 'sans-serif'] },
      animation: {
        'fade-up': 'fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards',
        'fade-in': 'fadeIn 0.5s ease-out forwards',
        'count-up': 'countUp 1s ease-out',
      },
      keyframes: {
        fadeUp: { '0%': { opacity: 0, transform: 'translateY(16px)' }, '100%': { opacity: 1, transform: 'translateY(0)' } },
        fadeIn: { '0%': { opacity: 0 }, '100%': { opacity: 1 } },
      },
    },
  },
};
</script>
<style>
  body { font-feature-settings: "ss01", "ss02"; }
  .stat-num { font-variant-numeric: tabular-nums; }
  .scroll-fade { opacity: 0; transform: translateY(20px); transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .scroll-fade.visible { opacity: 1; transform: translateY(0); }
  .tab-active { background: linear-gradient(135deg, #3ae20a 0%, #1ac6ff 100%); color: #0d1d3a !important; box-shadow: 0 4px 14px rgba(58,226,10,0.35); }
  .tab-active span { color: #0d1d3a; }
  .tab-active svg { opacity: 1 !important; color: #0d1d3a; }
  details > summary { list-style: none; cursor: pointer; }
  details > summary::-webkit-details-marker { display: none; }
  details[open] > summary .chev { transform: rotate(90deg); }
  .chev { transition: transform 0.2s ease; }
  .ai-prose h1, .ai-prose h2, .ai-prose h3, .ai-prose h4 { color: #172e55; font-weight: 700; margin: 1em 0 0.4em; line-height: 1.2; }
  .ai-prose h1 { font-size: 1.25rem; }
  .ai-prose h2 { font-size: 1.125rem; }
  .ai-prose h3 { font-size: 1rem; }
  .ai-prose h4 { font-size: 0.95rem; color: #4a5568; text-transform: uppercase; letter-spacing: 0.04em; }
  .ai-prose p { margin: 0.6em 0; }
  .ai-prose strong { color: #172e55; font-weight: 700; }
  .ai-prose em { color: #4a5568; }
  .ai-prose a { color: #1ac6ff; border-bottom: 1px solid rgba(26, 198, 255, 0.3); transition: border-color 0.15s; }
  .ai-prose a:hover { border-color: #1ac6ff; }
  .ai-prose ul, .ai-prose ol { margin: 0.6em 0; padding-left: 1.4em; }
  .ai-prose li { margin: 0.3em 0; }
  .ai-prose hr { border: none; border-top: 1px solid #e3e7ee; margin: 1em 0; }
  .gradient-text { background: linear-gradient(135deg, #3ae20a 0%, #1ac6ff 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .ai-prose-dark h1, .ai-prose-dark h2, .ai-prose-dark h3, .ai-prose-dark h4 { color: #ffffff; }
  .ai-prose-dark strong { color: #3ae20a; }
  .ai-prose-dark em { color: rgba(255,255,255,0.7); }
  .ai-prose-dark a { color: #1ac6ff; border-bottom-color: rgba(26,198,255,0.4); }
  .ai-prose-dark p, .ai-prose-dark li { color: rgba(255,255,255,0.85); }
  .ai-prose-dark hr { border-top-color: rgba(255,255,255,0.15); }
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
</head>
<body class="bg-slate-50 text-ink antialiased min-h-screen">

<!-- Hero -->
<section class="bg-gradient-to-br from-navy via-navy-deep to-navy text-white relative overflow-hidden">
  <div class="absolute inset-0 opacity-20" style="background-image: radial-gradient(circle at 20% 50%, #3ae20a 0%, transparent 40%), radial-gradient(circle at 80% 30%, #1ac6ff 0%, transparent 35%);"></div>
  <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-10 pb-12 relative z-10">
    <div class="flex items-center justify-between mb-8">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-full bg-navy-deep border-2 border-accent-green flex items-center justify-center font-bold text-accent-green">R</div>
        <div>
          <div class="text-xs tracking-[0.2em] uppercase text-accent-green font-bold">Raptor Roofing</div>
          <div class="text-sm text-white/70">Review Digest</div>
        </div>
      </div>
      <div class="text-right">
        <div class="text-xs tracking-widest uppercase text-white/60">Last Updated</div>
        <div class="text-sm font-semibold">{{ run_date }}</div>
      </div>
    </div>
    <h1 class="text-3xl sm:text-5xl font-bold tracking-tight mb-3">Indianapolis roofing,<br><span class="gradient-text">moved this week.</span></h1>
    <p class="text-white/70 text-sm sm:text-base max-w-2xl">Live competitive intel scraped from Google Maps, paired with web research from Claude. Refreshed Tuesday and Thursday at 7:30am Eastern.</p>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-8">
      <div class="bg-white/10 backdrop-blur border border-accent-green/20 rounded-xl p-4">
        <div class="text-3xl sm:text-4xl font-bold text-accent-green stat-num" data-count="{{ raptor.reviews_7d if raptor else 0 }}">+{{ raptor.reviews_7d if raptor else 0 }}</div>
        <div class="text-[10px] tracking-widest uppercase text-white/70 mt-1">Raptor 7 Days</div>
      </div>
      <div class="bg-white/10 backdrop-blur border border-accent-green/20 rounded-xl p-4">
        <div class="text-3xl sm:text-4xl font-bold text-accent-green stat-num" data-count="{{ raptor.reviews_30d if raptor else 0 }}">+{{ raptor.reviews_30d if raptor else 0 }}</div>
        <div class="text-[10px] tracking-widest uppercase text-white/70 mt-1">Raptor 30 Days</div>
      </div>
      <div class="bg-white/10 backdrop-blur border border-accent-blue/30 rounded-xl p-4">
        <div class="text-3xl sm:text-4xl font-bold text-accent-blue stat-num">#{{ raptor_rank or 'n/a' }}</div>
        <div class="text-[10px] tracking-widest uppercase text-white/70 mt-1">Volume Rank</div>
      </div>
      <div class="bg-white/10 backdrop-blur border border-accent-blue/30 rounded-xl p-4">
        <div class="text-3xl sm:text-4xl font-bold text-accent-blue stat-num">{% if raptor and raptor.response_rate %}{{ (raptor.response_rate * 100)|int }}%{% else %}–{% endif %}</div>
        <div class="text-[10px] tracking-widest uppercase text-white/70 mt-1">Response Rate</div>
      </div>
    </div>
  </div>
</section>

<!-- Sticky Tab Nav -->
<nav class="sticky top-0 z-30 bg-navy-deep/95 backdrop-blur-xl border-b border-accent-green/15 shadow-lg">
  <div class="max-w-6xl mx-auto px-3 sm:px-6">
    <div class="flex gap-1 sm:gap-2 overflow-x-auto no-scrollbar py-2">
      {% for tab in [('overview', 'Overview', 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6'), ('moves', "Raptor's Moves", 'M13 10V3L4 14h7v7l9-11h-7z'), ('movement', 'Movement', 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6'), ('news', 'News', 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z'), ('rising', 'Rising Players', 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6'), ('all', 'All Competitors', 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z')] %}
      <button data-tab="{{ tab[0] }}" class="tab-btn group whitespace-nowrap inline-flex items-center gap-2 px-3 sm:px-4 py-2.5 text-xs sm:text-sm font-semibold rounded-full text-white/60 hover:text-white hover:bg-white/5 transition-all">
        <svg class="w-4 h-4 opacity-70 group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ tab[2] }}"/></svg>
        <span>{{ tab[1] }}</span>
      </button>
      {% endfor %}
    </div>
  </div>
</nav>

<main class="max-w-6xl mx-auto px-5 sm:px-8 py-8 space-y-6">

  <!-- OVERVIEW TAB — high-level summary, click into other tabs for depth -->
  <section data-panel="overview" class="space-y-6">
    {% if raptor_actions %}
    <div class="scroll-fade bg-gradient-to-br from-navy to-navy-deep rounded-2xl shadow-xl p-6 sm:p-8 text-white relative overflow-hidden">
      <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-accent-green/10 blur-3xl"></div>
      <div class="absolute -bottom-20 -left-20 w-64 h-64 rounded-full bg-accent-blue/10 blur-3xl"></div>
      <div class="relative">
        <div class="flex items-center justify-between mb-5">
          <h2 class="text-base sm:text-lg font-bold text-white uppercase tracking-wider">This Week's Three Moves</h2>
          <span class="text-[10px] uppercase tracking-wider text-accent-green bg-accent-green/15 border border-accent-green/30 px-2 py-1 rounded-full">Live AI</span>
        </div>
        <div class="ai-prose ai-prose-dark text-sm sm:text-base">{{ raptor_actions | md }}</div>
        <button data-tab-link="moves" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-accent-green hover:text-accent-blue transition-colors">
          See full breakdown
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="scroll-fade bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h3 class="text-sm font-bold text-navy uppercase tracking-wider mb-4">Biggest Gainers This Week</h3>
        <div class="relative h-64 sm:h-72"><canvas id="gainers-chart"></canvas></div>
      </div>
      <div class="scroll-fade bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h3 class="text-sm font-bold text-navy uppercase tracking-wider mb-4">Velocity vs Volume</h3>
        <div class="relative h-64 sm:h-72"><canvas id="scatter-chart"></canvas></div>
        <p class="text-xs text-ink-soft mt-2">Top-right = high volume + high velocity. Bottom-right small dots = small base punching above weight.</p>
      </div>
    </div>
  </section>

  <!-- RAPTOR'S MOVES TAB — same actions, but here each one is expandable with deeper detail -->
  <section data-panel="moves" class="hidden space-y-6">
    <div class="bg-gradient-to-br from-navy to-navy-deep rounded-2xl shadow-xl p-6 sm:p-8 text-white relative overflow-hidden">
      <div class="absolute -top-32 right-0 w-72 h-72 rounded-full bg-accent-green/10 blur-3xl"></div>
      <div class="relative">
        <div class="flex items-center justify-between mb-2">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-white">Raptor's Moves This Week</h2>
            <p class="text-white/60 text-sm mt-1">Specific actions Claude Opus synthesized from this cycle's data plus market news.</p>
          </div>
          <span class="text-[10px] uppercase tracking-wider text-accent-green bg-accent-green/15 border border-accent-green/30 px-2 py-1 rounded-full">Live AI</span>
        </div>
        <div class="ai-prose ai-prose-dark text-sm sm:text-base mt-4">{{ raptor_actions | md if raptor_actions else 'No actions synthesized this week.' }}</div>
      </div>
    </div>
  </section>

  <!-- MOVEMENT TAB -->
  <section data-panel="movement" class="hidden space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h3 class="text-sm font-bold text-navy uppercase tracking-wider mb-4">Response Rate Comparison</h3>
        <div class="relative h-72 sm:h-80"><canvas id="response-chart"></canvas></div>
        <p class="text-xs text-ink-soft mt-2">% of reviews each competitor has replied to. Google factors engagement into local rankings.</p>
      </div>
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
        <h3 class="text-sm font-bold text-navy uppercase tracking-wider mb-4">Share of This Week's Reviews</h3>
        <div class="relative h-72 sm:h-80"><canvas id="share-chart"></canvas></div>
        <p class="text-xs text-ink-soft mt-2">Of all new reviews captured by tracked competitors this week, who got what slice.</p>
      </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-100">
        <h3 class="text-sm font-bold text-navy uppercase tracking-wider">Full Weekly Gains</h3>
        <p class="text-xs text-ink-soft mt-1">Sortable. Click any company name to open its profile.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wider text-ink-soft">
            <tr>
              <th class="text-left px-4 py-3 font-semibold">#</th>
              <th class="text-left px-4 py-3 font-semibold">Company</th>
              <th class="text-right px-4 py-3 font-semibold">Total</th>
              <th class="text-right px-4 py-3 font-semibold">★</th>
              <th class="text-right px-4 py-3 font-semibold">7d</th>
              <th class="text-right px-4 py-3 font-semibold">30d</th>
              <th class="text-right px-4 py-3 font-semibold">90d</th>
              <th class="text-right px-4 py-3 font-semibold">Resp</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {% for biz in by_gain_7d[:30] %}
            <tr class="{% if 'raptor' in biz.name.lower() %}bg-accent-green/5 border-l-4 border-l-accent-green{% endif %} hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 text-ink-soft">{{ loop.index }}</td>
              <td class="px-4 py-3 font-medium text-navy">{{ biz.name }}</td>
              <td class="px-4 py-3 text-right stat-num">{{ '{:,}'.format(biz.review_count) }}</td>
              <td class="px-4 py-3 text-right">{{ biz.rating if biz.rating is not none else '–' }}</td>
              <td class="px-4 py-3 text-right font-bold {% if biz.reviews_7d and biz.reviews_7d > 0 %}text-emerald-600{% else %}text-ink-light{% endif %}">+{{ biz.reviews_7d or 0 }}</td>
              <td class="px-4 py-3 text-right text-ink-soft">+{{ biz.reviews_30d or 0 }}</td>
              <td class="px-4 py-3 text-right text-ink-soft">+{{ biz.reviews_90d or 0 }}</td>
              <td class="px-4 py-3 text-right text-ink-soft">{% if biz.response_rate is not none %}{{ (biz.response_rate * 100)|int }}%{% else %}–{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- NEWS TAB — grid of cards, click to open modal with full detail -->
  <section data-panel="news" class="hidden space-y-6">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-navy">This Week in Indy Roofing</h2>
        <p class="text-sm text-ink-soft mt-1">Awards, press, expansions, hires, and marketing moves from the past 7 days. Click any card for the full story.</p>
      </div>
      <span class="text-[10px] uppercase tracking-wider text-ink-soft bg-slate-100 px-2 py-1 rounded">Web Researched</span>
    </div>

    {% if news_cards %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {% for card in news_cards %}
      <button onclick="openNews({{ loop.index0 }})" class="news-card text-left bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-lg hover:border-accent-green/30 hover:-translate-y-0.5 transition-all p-5 group">
        <div class="flex items-start justify-between mb-3">
          <span class="text-2xl">{{ card.icon }}</span>
          {% if card.when %}<span class="text-[10px] uppercase tracking-wider text-ink-soft bg-slate-100 px-2 py-1 rounded">{{ card.when }}</span>{% endif %}
        </div>
        <div class="font-bold text-navy text-base mb-1">{{ card.company }}</div>
        <div class="text-sm text-ink-soft line-clamp-3">{{ card.event }}</div>
        <div class="mt-3 flex items-center gap-1 text-xs font-semibold text-accent-blue group-hover:text-navy">
          Read more
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </div>
      </button>
      {% endfor %}
    </div>

    <!-- Hidden modal -->
    <div id="news-modal" class="fixed inset-0 z-50 hidden">
      <div class="absolute inset-0 bg-navy-deep/70 backdrop-blur-sm" onclick="closeNews()"></div>
      <div class="relative max-w-2xl mx-auto mt-12 mb-12 bg-white rounded-2xl shadow-2xl overflow-hidden animate-fade-up">
        <div class="bg-gradient-to-br from-navy to-navy-deep text-white p-6 relative">
          <button onclick="closeNews()" class="absolute top-4 right-4 text-white/70 hover:text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
          <div id="news-modal-icon" class="text-3xl mb-2"></div>
          <h3 id="news-modal-company" class="text-xl font-bold"></h3>
          <p id="news-modal-when" class="text-white/70 text-xs mt-1 uppercase tracking-wider"></p>
        </div>
        <div class="p-6 space-y-4">
          <div>
            <div class="text-[10px] uppercase tracking-wider text-ink-soft mb-1">What happened</div>
            <p id="news-modal-event" class="text-sm"></p>
          </div>
          <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded">
            <div class="text-[10px] uppercase tracking-wider text-yellow-800 mb-1">Why it matters for Raptor</div>
            <p id="news-modal-why" class="text-sm"></p>
          </div>
          <a id="news-modal-source" href="#" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-sm font-semibold text-accent-blue hover:text-navy">
            View source
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>
    </div>
    <script>window.NEWS_CARDS = {{ news_cards | tojson }};</script>
    {% else %}
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8 text-center text-ink-soft">No significant market news this cycle.</div>
    {% endif %}
  </section>

  <!-- RISING PLAYERS TAB -->
  <section data-panel="rising" class="hidden space-y-6">
    {% if rising_profiles %}
    {% for rp in rising_profiles %}
    <details class="scroll-fade bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden group" {% if loop.first %}open{% endif %}>
      <summary class="p-5 sm:p-6 flex items-center justify-between hover:bg-slate-50 transition-colors">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-3 flex-wrap">
            <h3 class="text-base sm:text-lg font-bold text-navy">{{ rp.competitor.name }}</h3>
            <span class="text-xs px-2 py-0.5 bg-accent-green/15 text-emerald-700 rounded-full font-semibold uppercase tracking-wide">+{{ rp.competitor.reviews_7d or 0 }} this week</span>
          </div>
          <div class="text-xs text-ink-soft mt-1">{{ rp.competitor.review_count }} reviews · {{ rp.competitor.rating }} stars · +{{ rp.competitor.reviews_30d or 0 }} in 30 days</div>
        </div>
        <svg class="chev w-5 h-5 text-ink-soft flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </summary>
      <div class="px-5 sm:px-6 pb-6 ai-prose text-sm border-t border-slate-100 pt-5">{{ rp.profile | md }}</div>
    </details>
    {% endfor %}
    {% else %}
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8 text-center text-ink-soft">No rising players flagged this cycle. The thresholds may need adjustment, or the market is quiet.</div>
    {% endif %}
  </section>

  <!-- ALL COMPETITORS TAB — top 50, click any row to open competitor profile -->
  <section data-panel="all" class="hidden space-y-6">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-6 border-b border-slate-100 flex items-center justify-between flex-wrap gap-2">
        <div>
          <h3 class="text-sm font-bold text-navy uppercase tracking-wider">All Tracked Competitors</h3>
          <p class="text-xs text-ink-soft mt-1">Top 50 by review volume. Click any name for a deeper profile (coming soon).</p>
        </div>
        <span class="text-[10px] uppercase tracking-wider text-ink-soft bg-slate-100 px-2 py-1 rounded">{{ by_volume | length }} tracked</span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-slate-50 text-xs uppercase tracking-wider text-ink-soft sticky top-0">
            <tr>
              <th class="text-left px-4 py-3 font-semibold">#</th>
              <th class="text-left px-4 py-3 font-semibold">Company</th>
              <th class="text-right px-4 py-3 font-semibold">Total</th>
              <th class="text-right px-4 py-3 font-semibold">★</th>
              <th class="text-right px-4 py-3 font-semibold">7d</th>
              <th class="text-right px-4 py-3 font-semibold">30d</th>
              <th class="text-right px-4 py-3 font-semibold">90d</th>
              <th class="text-right px-4 py-3 font-semibold">Resp</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {% for biz in by_volume[:50] %}
            <tr onclick="window.location.href='competitor/{{ biz.slug }}/'" class="{% if 'raptor' in biz.name.lower() %}bg-accent-green/5 border-l-4 border-l-accent-green{% endif %} hover:bg-slate-50 cursor-pointer transition-colors group">
              <td class="px-4 py-3 text-ink-soft">{{ loop.index }}</td>
              <td class="px-4 py-3 font-medium text-navy">
                <a href="competitor/{{ biz.slug }}/" class="hover:text-accent-blue transition-colors group-hover:underline">{{ biz.name }} <svg class="inline w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
              </td>
              <td class="px-4 py-3 text-right stat-num">{{ '{:,}'.format(biz.review_count) }}</td>
              <td class="px-4 py-3 text-right">{{ biz.rating if biz.rating is not none else '–' }}</td>
              <td class="px-4 py-3 text-right font-bold {% if biz.reviews_7d and biz.reviews_7d > 0 %}text-emerald-600{% else %}text-ink-light{% endif %}">+{{ biz.reviews_7d or 0 }}</td>
              <td class="px-4 py-3 text-right text-ink-soft">+{{ biz.reviews_30d or 0 }}</td>
              <td class="px-4 py-3 text-right text-ink-soft">+{{ biz.reviews_90d or 0 }}</td>
              <td class="px-4 py-3 text-right text-ink-soft">{% if biz.response_rate is not none %}{{ (biz.response_rate * 100)|int }}%{% else %}–{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>

</main>

<footer class="max-w-6xl mx-auto px-5 sm:px-8 py-10 mt-8 border-t border-slate-200 text-xs text-ink-soft">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div>
      <div class="font-semibold text-navy">Raptor Roofing | Review Digest</div>
      <div>5145 S. Meridian St., Suite B · Indianapolis, IN 46217 · 317.886.0696</div>
    </div>
    <div class="text-right">
      <div>Generated {{ run_date }}</div>
      <div>Refreshed Tuesdays and Thursdays at 7:30am Eastern</div>
    </div>
  </div>
</footer>

<script>
// === Tab switching ===
const tabs = document.querySelectorAll('.tab-btn');
const panels = document.querySelectorAll('[data-panel]');
function showTab(name) {
  tabs.forEach(t => t.classList.toggle('tab-active', t.dataset.tab === name));
  panels.forEach(p => p.classList.toggle('hidden', p.dataset.panel !== name));
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
tabs.forEach(t => t.addEventListener('click', () => showTab(t.dataset.tab)));
document.querySelectorAll('[data-tab-link]').forEach(b => b.addEventListener('click', () => showTab(b.dataset.tabLink)));
showTab('overview');

// === News modal ===
function openNews(idx) {
  const card = (window.NEWS_CARDS || [])[idx];
  if (!card) return;
  document.getElementById('news-modal-icon').textContent = card.icon || '📌';
  document.getElementById('news-modal-company').textContent = card.company || '';
  document.getElementById('news-modal-when').textContent = card.when || '';
  document.getElementById('news-modal-event').textContent = card.event || '';
  document.getElementById('news-modal-why').textContent = card.why_matters || card.why || '';
  const src = document.getElementById('news-modal-source');
  if (card.source && card.source.startsWith('http')) {
    src.href = card.source;
    src.style.display = 'inline-flex';
  } else {
    src.style.display = 'none';
  }
  document.getElementById('news-modal').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}
function closeNews() {
  document.getElementById('news-modal').classList.add('hidden');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeNews(); });

// === Scroll-fade animation ===
const observer = new IntersectionObserver((entries) => {
  entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
}, { threshold: 0.1 });
document.querySelectorAll('.scroll-fade').forEach(el => observer.observe(el));

// === Count-up hero stats ===
function countUp(el) {
  const target = parseInt(el.dataset.count, 10);
  if (!Number.isFinite(target)) return;
  const duration = 900;
  const start = performance.now();
  const prefix = el.textContent.startsWith('+') ? '+' : '';
  function step(now) {
    const t = Math.min(1, (now - start) / duration);
    const eased = 1 - Math.pow(1 - t, 3);
    el.textContent = prefix + Math.round(target * eased).toLocaleString();
    if (t < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}
document.querySelectorAll('[data-count]').forEach(countUp);

// === Charts ===
const DATA = {{ chart_data | tojson }};
const NAVY = '#172e55';
const GREEN = '#3ae20a';
const BLUE = '#1ac6ff';
const SOFT = '#e3e7ee';

Chart.defaults.font.family = "'Ouma Latin VF', 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif";
Chart.defaults.color = '#4a5568';
Chart.defaults.borderColor = SOFT;

// Gainers bar
new Chart(document.getElementById('gainers-chart'), {
  type: 'bar',
  data: {
    labels: DATA.gainers.map(g => g.name),
    datasets: [{
      data: DATA.gainers.map(g => g.gain_7d),
      backgroundColor: DATA.gainers.map(g => g.is_raptor ? GREEN : NAVY),
      borderRadius: 6,
    }],
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
      x: { grid: { display: false } },
      y: { beginAtZero: true, grid: { color: SOFT }, ticks: { precision: 0 } },
    },
  },
});

// Velocity-vs-volume scatter
new Chart(document.getElementById('scatter-chart'), {
  type: 'scatter',
  data: {
    datasets: DATA.scatter.map(p => ({
      label: p.name,
      data: [{ x: p.total, y: p.gain_7d, r: 6 + (p.is_raptor ? 4 : 0) }],
      backgroundColor: p.is_raptor ? GREEN : (p.gain_7d > 5 ? BLUE : NAVY),
      pointRadius: 6 + (p.is_raptor ? 4 : 0),
      pointHoverRadius: 10,
    })),
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { display: false },
      tooltip: {
        callbacks: { label: (ctx) => `${ctx.dataset.label}: ${ctx.parsed.x.toLocaleString()} total, +${ctx.parsed.y} this week` },
      },
    },
    scales: {
      x: { type: 'logarithmic', title: { display: true, text: 'Total Reviews (log)' }, grid: { color: SOFT } },
      y: { beginAtZero: true, title: { display: true, text: 'Reviews this week' }, grid: { color: SOFT } },
    },
  },
});

// Response rate horizontal bar
new Chart(document.getElementById('response-chart'), {
  type: 'bar',
  data: {
    labels: DATA.response.map(r => r.name),
    datasets: [{
      data: DATA.response.map(r => r.rate),
      backgroundColor: DATA.response.map(r => r.is_raptor ? GREEN : NAVY),
      borderRadius: 4,
    }],
  },
  options: {
    indexAxis: 'y',
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false }, tooltip: { callbacks: { label: (ctx) => `${ctx.parsed.x}%` } } },
    scales: {
      x: { beginAtZero: true, max: 100, grid: { color: SOFT }, ticks: { callback: (v) => v + '%' } },
      y: { grid: { display: false } },
    },
  },
});

// Share donut
new Chart(document.getElementById('share-chart'), {
  type: 'doughnut',
  data: {
    labels: DATA.share.map(s => s.name),
    datasets: [{
      data: DATA.share.map(s => s.gain),
      backgroundColor: DATA.share.map((s, i) => s.is_raptor ? GREEN : [NAVY, BLUE, '#2a4880', '#6b7d99', '#a3b1c7', '#d4dbe6'][i % 6]),
      borderWidth: 2,
      borderColor: '#fff',
    }],
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { position: 'right', labels: { boxWidth: 12, font: { size: 11 } } } },
    cutout: '65%',
  },
});
</script>
</body>
</html>
