<script>
const tabs = document.querySelectorAll('.tab-btn');
const panels = document.querySelectorAll('[data-panel]');
function showTab(name) {
  tabs.forEach(t => t.classList.toggle('tab-active', t.dataset.tab === name));
  panels.forEach(p => p.classList.toggle('hidden', p.dataset.panel !== name));
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
tabs.forEach(t => t.addEventListener('click', () => showTab(t.dataset.tab)));
document.querySelectorAll('[data-tab-link]').forEach(b => b.addEventListener('click', () => showTab(b.dataset.tabLink)));
showTab('overview');

// Inject SVG icons into news cards based on category
document.querySelectorAll('[data-cat-icon]').forEach(el => {
  const cat = el.dataset.catIcon || 'other';
  const valid = ['award','press','expansion','hire','ad','regulation','weather','supply','partnership','other'];
  const id = valid.includes(cat) ? cat : 'other';
  el.innerHTML = `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#icon-${id}"/></svg>`;
});

const observer = new IntersectionObserver((entries) => { entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }); }, { threshold: 0.1 });
document.querySelectorAll('.scroll-fade').forEach(el => observer.observe(el));

function openNews(idx) {
  const card = (window.NEWS_CARDS || [])[idx];
  if (!card) return;
  const iconEl = document.getElementById('news-modal-icon');
  const cat = card.category || 'other';
  iconEl.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><use href="#icon-${cat}"/></svg>`;
  document.getElementById('news-modal-company').textContent = card.company || '';
  document.getElementById('news-modal-when').textContent = card.when || '';
  document.getElementById('news-modal-event').textContent = card.event || '';
  document.getElementById('news-modal-why').textContent = card.why_matters || card.why || '';
  const detailEl = document.getElementById('news-modal-detail');
  const detailWrap = document.getElementById('news-modal-detail-wrap');
  if (card.detail) {
    detailEl.textContent = card.detail;
    detailWrap.style.display = '';
  } else {
    detailWrap.style.display = 'none';
  }
  const src = document.getElementById('news-modal-source');
  if (card.source && card.source.startsWith('http')) {
    src.href = card.source; src.style.display = 'inline-flex';
  } else { src.style.display = 'none'; }
  document.getElementById('news-modal').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}
function closeNews() {
  document.getElementById('news-modal').classList.add('hidden');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeNews(); });

// Sortable tables — click any header to sort asc/desc
document.querySelectorAll('.sortable-table').forEach(table => {
  const headers = table.querySelectorAll('thead th[data-sort]');
  let currentDir = {};
  headers.forEach((h, idx) => {
    h.addEventListener('click', () => {
      const tbody = table.querySelector('tbody');
      const rows = Array.from(tbody.querySelectorAll('tr'));
      const dir = currentDir[idx] === 'asc' ? 'desc' : 'asc';
      headers.forEach(x => x.classList.remove('sorted-asc', 'sorted-desc'));
      h.classList.add(dir === 'asc' ? 'sorted-asc' : 'sorted-desc');
      currentDir = {}; currentDir[idx] = dir;
      const sortType = h.dataset.sort;
      rows.sort((a, b) => {
        let av = a.children[idx].dataset.val ?? a.children[idx].textContent;
        let bv = b.children[idx].dataset.val ?? b.children[idx].textContent;
        if (sortType === 'num') { av = parseFloat(av) || 0; bv = parseFloat(bv) || 0; }
        else { av = String(av).toLowerCase(); bv = String(bv).toLowerCase(); }
        if (av < bv) return dir === 'asc' ? -1 : 1;
        if (av > bv) return dir === 'asc' ? 1 : -1;
        return 0;
      });
      rows.forEach(r => tbody.appendChild(r));
    });
  });
});

const DATA = {{ chart_data | tojson }};
const NAVY_LIGHT = '#2a4880';
const GREEN = '#3ae20a';
const BLUE = '#1ac6ff';
const SOFT = 'rgba(196, 206, 224, 0.1)';
const TEXT_SOFT = '#c4cee0';

Chart.defaults.font.family = "'Ouma Latin VF', 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif";
Chart.defaults.color = TEXT_SOFT;
Chart.defaults.borderColor = SOFT;

new Chart(document.getElementById('gainers-chart'), {
  type: 'bar',
  data: {
    labels: DATA.gainers.map(g => g.name),
    datasets: [{
      data: DATA.gainers.map(g => g.gain_7d),
      backgroundColor: DATA.gainers.map(g => g.is_raptor ? GREEN : NAVY_LIGHT),
      borderRadius: 6,
    }],
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    layout: { padding: { top: 24 } },
    plugins: { legend: { display: false }, tooltip: { backgroundColor: '#0d1d3a', borderColor: '#c4cee0', borderWidth: 1, titleColor: '#fff', bodyColor: '#fff' } },
    scales: {
      x: { ticks: { color: TEXT_SOFT, autoSkip: false, maxRotation: 45, minRotation: 35 }, grid: { display: false } },
      y: { beginAtZero: true, grid: { color: SOFT }, ticks: { precision: 0, color: TEXT_SOFT } },
    },
    animation: {
      onComplete: function() {
        const chart = this; const ctx = chart.ctx;
        ctx.font = "bold 11px 'Inter', sans-serif"; ctx.fillStyle = '#ffffff'; ctx.textAlign = 'center';
        chart.data.datasets[0].data.forEach((v, i) => {
          const meta = chart.getDatasetMeta(0); const bar = meta.data[i];
          ctx.fillText('+' + v, bar.x, bar.y - 6);
        });
      },
    },
  },
});

new Chart(document.getElementById('scatter-chart'), {
  type: 'scatter',
  data: {
    datasets: DATA.scatter.map(p => ({
      label: p.name,
      data: [{ x: p.total, y: p.gain_7d }],
      backgroundColor: p.is_raptor ? GREEN : (p.gain_7d > 5 ? BLUE : NAVY_LIGHT),
      pointRadius: p.is_raptor ? 6 : 5,
      pointHoverRadius: p.is_raptor ? 9 : 8,
      pointBorderColor: p.is_raptor ? '#ffffff' : 'transparent',
      pointBorderWidth: p.is_raptor ? 2 : 0,
    })),
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false }, tooltip: { backgroundColor: '#0d1d3a', borderColor: '#c4cee0', borderWidth: 1, titleColor: '#fff', bodyColor: '#fff', callbacks: { label: (ctx) => `${ctx.dataset.label}: ${ctx.parsed.x.toLocaleString()} total, +${ctx.parsed.y} this week` } } },
    scales: {
      x: { type: 'logarithmic', title: { display: true, text: 'Total Reviews (log)', color: TEXT_SOFT }, grid: { color: SOFT }, ticks: { color: TEXT_SOFT } },
      y: { beginAtZero: true, title: { display: true, text: 'Reviews this week', color: TEXT_SOFT }, grid: { color: SOFT }, ticks: { color: TEXT_SOFT } },
    },
  },
});

new Chart(document.getElementById('response-chart'), {
  type: 'bar',
  data: {
    labels: DATA.response.map(r => r.name),
    datasets: [{
      data: DATA.response.map(r => r.rate),
      backgroundColor: DATA.response.map(r => r.is_raptor ? GREEN : NAVY_LIGHT),
      borderRadius: 4,
    }],
  },
  options: {
    indexAxis: 'y',
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false }, tooltip: { backgroundColor: '#0d1d3a', titleColor: '#fff', bodyColor: '#fff', callbacks: { label: (ctx) => `${ctx.parsed.x}%` } } },
    scales: {
      x: { beginAtZero: true, max: 100, grid: { color: SOFT }, ticks: { color: TEXT_SOFT, callback: (v) => v + '%' } },
      y: { grid: { display: false }, ticks: { color: TEXT_SOFT } },
    },
  },
});

new Chart(document.getElementById('share-chart'), {
  type: 'doughnut',
  data: {
    labels: DATA.share.map(s => s.name),
    datasets: [{
      data: DATA.share.map(s => s.gain),
      backgroundColor: DATA.share.map((s, i) => s.is_raptor ? GREEN : ['#2a4880', '#4a679a', '#7d92ba', '#1ac6ff', '#a3b1c7', '#c4cee0'][i % 6]),
      borderWidth: 2,
      borderColor: '#0d1d3a',
    }],
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { position: 'right', labels: { color: TEXT_SOFT, boxWidth: 12, font: { size: 11 } } }, tooltip: { backgroundColor: '#0d1d3a', titleColor: '#fff', bodyColor: '#fff' } },
    cutout: '65%',
  },
});
</script>
</body>
</html>
