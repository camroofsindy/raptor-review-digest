<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Raptor Review Digest | {{ run_date }}</title>
<meta name="description" content="Weekly competitive intelligence for Raptor Roofing in Indianapolis.">
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='45' fill='%23172e55'/%3E%3Ctext x='50' y='62' font-size='40' text-anchor='middle' fill='%233ae20a' font-family='sans-serif' font-weight='700'%3ER%3C/text%3E%3C/svg%3E">

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0"></script>
<script>
tailwind.config = {
  theme: {
    extend: {
      colors: {
        navy: { 50: '#e8ecf3', 100: '#c4cee0', 200: '#7d92ba', 300: '#4a679a', DEFAULT: '#172e55', deep: '#0d1d3a', darker: '#08142a', light: '#2a4880', surface: '#1a2f54' },
        accent: { green: '#3ae20a', blue: '#1ac6ff' },
        ink: { DEFAULT: '#ffffff', soft: '#c4cee0', mute: '#7d92ba', dim: '#4a679a' },
      },
      fontFamily: { sans: ['Ouma Latin VF', 'Inter', 'Helvetica Neue', 'Helvetica', 'Arial', 'sans-serif'] },
    },
  },
};
</script>
<style>
  body { font-feature-settings: "ss01", "ss02"; background-color: #08142a; }
  .stat-num { font-variant-numeric: tabular-nums; }
  .scroll-fade { opacity: 0; transform: translateY(20px); transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .scroll-fade.visible { opacity: 1; transform: translateY(0); }
  .tab-active { background: rgba(58, 226, 10, 0.15); color: #ffffff !important; border: 1px solid rgba(58, 226, 10, 0.45); }
  .tab-active span { color: #ffffff; }
  .tab-active svg { opacity: 1 !important; color: #3ae20a; }
  details > summary { list-style: none; cursor: pointer; }
  details > summary::-webkit-details-marker { display: none; }
  details[open] > summary .chev { transform: rotate(90deg); }
  .chev { transition: transform 0.2s ease; }

  .panel {
    background: linear-gradient(180deg, rgba(26, 47, 84, 0.7) 0%, rgba(13, 29, 58, 0.85) 100%);
    border: 1px solid rgba(196, 206, 224, 0.08);
    border-radius: 16px;
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    position: relative;
    overflow: hidden;
  }
  .panel-hero {
    background: linear-gradient(135deg, rgba(26, 47, 84, 0.95) 0%, rgba(13, 29, 58, 0.95) 100%);
    border: 1px solid rgba(196, 206, 224, 0.12);
    border-radius: 16px;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .ai-prose { color: rgba(255, 255, 255, 0.92); }
  .ai-prose h1, .ai-prose h2, .ai-prose h3, .ai-prose h4 { color: #ffffff; font-weight: 700; margin: 1.4em 0 0.5em; line-height: 1.25; }
  .ai-prose h1 { font-size: 1.35rem; }
  .ai-prose h2 { font-size: 1.125rem; padding-top: 0.6em; border-top: 1px solid rgba(196, 206, 224, 0.12); }
  .ai-prose h2:first-child { border-top: none; padding-top: 0; }
  .ai-prose h3 { font-size: 1rem; color: #c4cee0; }
  .ai-prose h4 { font-size: 0.85rem; color: #7d92ba; text-transform: uppercase; letter-spacing: 0.05em; }
  .ai-prose p { margin: 0.7em 0; line-height: 1.65; color: rgba(255, 255, 255, 0.9); }
  .ai-prose strong { color: #ffffff; font-weight: 700; }
  .ai-prose em { color: #c4cee0; font-style: italic; }
  .ai-prose ul, .ai-prose ol { padding-left: 1.4em; margin: 0.6em 0; }
  .ai-prose li { margin: 0.4em 0; line-height: 1.6; }
  .ai-prose a { color: #1ac6ff; border-bottom: 1px solid rgba(26, 198, 255, 0.4); transition: border-color 0.15s; }
  .ai-prose a:hover { color: #ffffff; }
  .ai-prose hr { border: none; border-top: 1px solid rgba(255, 255, 255, 0.1); margin: 1.5em 0; }

  .accent-text { color: #3ae20a; }
  .gradient-line { background: linear-gradient(90deg, transparent, rgba(58, 226, 10, 0.4), transparent); height: 1px; }
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  /* Tables */
  .data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .data-table thead th { text-align: left; padding: 12px 10px; background: rgba(13, 29, 58, 0.6); border-bottom: 1px solid rgba(196, 206, 224, 0.18); font-weight: 700; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #c4cee0; cursor: pointer; user-select: none; }
  .data-table thead th:hover { color: #ffffff; background: rgba(26, 47, 84, 0.7); }
  .data-table thead th.sorted-asc::after, .data-table thead th.sorted-desc::after { content: ''; display: inline-block; margin-left: 4px; border-left: 4px solid transparent; border-right: 4px solid transparent; vertical-align: middle; }
  .data-table thead th.sorted-asc::after { border-bottom: 5px solid #3ae20a; }
  .data-table thead th.sorted-desc::after { border-top: 5px solid #3ae20a; }
  .data-table tbody td { padding: 12px 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); vertical-align: top; color: rgba(255, 255, 255, 0.85); }
  .data-table tbody tr:hover { background: rgba(58, 226, 10, 0.04); }
  .data-table tbody tr.raptor-row { background: rgba(58, 226, 10, 0.08); border-left: 3px solid #3ae20a; }
  .data-table tbody tr.raptor-row td { color: #ffffff; font-weight: 600; }
  .text-up { color: #3ae20a; font-weight: 700; }
  .text-flat { color: #7d92ba; }

  /* Bottom mobile nav */
  .mobile-nav { display: none; }
  @media (max-width: 768px) {
    .desktop-nav { display: none; }
    .mobile-nav { display: block; position: fixed; bottom: 0; left: 0; right: 0; z-index: 50; background: rgba(8, 20, 42, 0.96); backdrop-filter: blur(12px); border-top: 1px solid rgba(58, 226, 10, 0.2); padding: 8px 4px; padding-bottom: calc(8px + env(safe-area-inset-bottom)); }
    .mobile-nav-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; }
    .mobile-tab { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 6px 2px; border-radius: 8px; color: #7d92ba; transition: all 0.15s; }
    .mobile-tab svg { width: 18px; height: 18px; margin-bottom: 2px; }
    .mobile-tab span { font-size: 9px; font-weight: 600; letter-spacing: 0.02em; line-height: 1.1; text-align: center; }
    .mobile-tab.tab-active { background: rgba(58, 226, 10, 0.15); color: #ffffff; border: 1px solid rgba(58, 226, 10, 0.4); }
    .mobile-tab.tab-active svg { color: #3ae20a; }
    main { padding-bottom: 90px !important; }
  }
</style>
</head>
<body class="text-white antialiased min-h-screen">

<div class="fixed inset-0 pointer-events-none" style="background-image: radial-gradient(circle at 15% 0%, rgba(58, 226, 10, 0.04) 0%, transparent 40%), radial-gradient(circle at 85% 50%, rgba(26, 198, 255, 0.04) 0%, transparent 35%);"></div>

<!-- Hero -->
<section class="relative z-10">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-8 pb-8">
    <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
      <img src="assets/logo.webp" alt="Raptor Roofing" class="h-12 sm:h-14 w-auto" onerror="this.style.display='none'">
      <div class="text-right">
        <div class="text-[10px] tracking-[0.2em] uppercase text-ink-mute">Last Updated</div>
        <div class="text-sm font-semibold text-white">{{ run_date }}</div>
      </div>
    </div>

    {# Dynamic position + threat headline #}
    <div class="space-y-3 max-w-3xl">
      <h1 class="text-2xl sm:text-4xl font-bold tracking-tight leading-tight text-white">
        Raptor sits <span class="text-accent-green">#{{ raptor_rank or 'n/a' }}</span> of {{ snapshot.businesses|length }} tracked Indy roofers.
        {% if next_above_gap %}<span class="block text-ink-soft text-xl sm:text-2xl font-medium mt-1">{{ next_above_gap }} reviews from passing {{ next_above.name }}.</span>{% endif %}
      </h1>
      {% if top_threat %}
      <p class="text-ink-soft text-sm sm:text-base">
        This week's headline: <span class="text-white font-semibold">{{ top_threat.company }}</span> &mdash; {{ top_threat.event[:140] }}{% if top_threat.event|length > 140 %}...{% endif %}
      </p>
      {% endif %}
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-7">
      <div class="panel p-4">
        <div class="text-3xl sm:text-4xl font-bold stat-num text-white">+{{ raptor.reviews_7d if raptor else 0 }}</div>
        <div class="text-[10px] tracking-widest uppercase text-ink-mute mt-1">Raptor 7 Days</div>
      </div>
      <div class="panel p-4">
        <div class="text-3xl sm:text-4xl font-bold stat-num text-white">+{{ raptor.reviews_30d if raptor else 0 }}</div>
        <div class="text-[10px] tracking-widest uppercase text-ink-mute mt-1">Raptor 30 Days</div>
      </div>
      <div class="panel p-4">
        <div class="text-3xl sm:text-4xl font-bold stat-num text-white">{% if next_above_gap %}{{ next_above_gap }}{% else %}–{% endif %}</div>
        <div class="text-[10px] tracking-widest uppercase text-ink-mute mt-1">Reviews to {% if next_above %}#{{ raptor_rank - 1 }}{% else %}go{% endif %}</div>
      </div>
      <div class="panel p-4">
        <div class="text-3xl sm:text-4xl font-bold stat-num text-white">{% if raptor and raptor.response_rate %}{{ (raptor.response_rate * 100)|int }}%{% else %}–{% endif %}</div>
        <div class="text-[10px] tracking-widest uppercase text-ink-mute mt-1">Response Rate</div>
      </div>
    </div>
  </div>
</section>

{% set _tabs = [
  ('overview', 'Overview', 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6'),
  ('moves', 'Moves', 'M13 10V3L4 14h7v7l9-11h-7z'),
  ('movement', 'Movement', 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6'),
  ('news', 'News', 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z'),
  ('rising', 'Rising', 'M3 17l6-6 4 4 8-8m0 0v6m0-6h-6'),
  ('seo', 'SEO/AEO', 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z'),
  ('all', 'All Comp.', 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z')
] %}

<!-- Desktop Sticky Tab Nav -->
<nav class="desktop-nav sticky top-0 z-30 bg-navy-darker/95 backdrop-blur-xl border-b border-white/10 shadow-lg">
  <div class="max-w-6xl mx-auto px-3 sm:px-6">
    <div class="flex gap-1 sm:gap-2 overflow-x-auto no-scrollbar py-2">
      {% for tab in _tabs %}
      <button data-tab="{{ tab[0] }}" class="tab-btn group whitespace-nowrap inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold rounded-lg text-ink-soft hover:text-white hover:bg-white/5 transition-all border border-transparent">
        <svg class="w-4 h-4 opacity-70 group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ tab[2] }}"/></svg>
        <span>{{ tab[1] }}</span>
      </button>
      {% endfor %}
    </div>
  </div>
</nav>

<main class="relative z-10 max-w-6xl mx-auto px-5 sm:px-8 py-8 space-y-6">

  <!-- OVERVIEW TAB -->
  <section data-panel="overview" class="space-y-6">
    {% if action_headlines %}
    <div class="scroll-fade panel-hero p-6 sm:p-8">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-base sm:text-lg font-bold text-white uppercase tracking-wider">This Week's Three Moves</h2>
        <span class="text-[10px] uppercase tracking-wider text-ink-soft bg-white/5 px-2 py-1 rounded border border-white/10">Live AI</span>
      </div>
      <ol class="space-y-4">
        {% for headline in action_headlines %}
        <li class="flex gap-3 text-base sm:text-lg leading-snug">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-white/10 border border-white/20 text-white flex items-center justify-center text-xs font-bold">{{ loop.index }}</span>
          <span class="text-white font-medium">{{ headline | replace(loop.index|string ~ '.', '') | trim }}</span>
        </li>
        {% endfor %}
      </ol>
      <button data-tab-link="moves" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent-green hover:text-white transition-colors">
        See full breakdown with reasoning
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
    {% endif %}

    {% if overview_summary %}
    <div class="scroll-fade panel p-6 sm:p-8">
      <h2 class="text-xs font-bold text-ink-soft uppercase tracking-[0.15em] mb-2">5-Minute Brief</h2>
      <p class="text-sm text-ink-mute mb-6">CMO summary of every tab. Click any link to dive deeper.</p>
      <div class="ai-prose text-sm sm:text-base">{{ overview_summary | md }}</div>
      <div class="mt-6 flex flex-wrap gap-3">
        <button data-tab-link="news" class="text-xs font-semibold text-accent-green hover:text-white transition-colors inline-flex items-center gap-1">News &rarr;</button>
        <button data-tab-link="rising" class="text-xs font-semibold text-accent-green hover:text-white transition-colors inline-flex items-center gap-1">Rising &rarr;</button>
        <button data-tab-link="seo" class="text-xs font-semibold text-accent-green hover:text-white transition-colors inline-flex items-center gap-1">SEO/AEO &rarr;</button>
        <button data-tab-link="all" class="text-xs font-semibold text-accent-green hover:text-white transition-colors inline-flex items-center gap-1">All Competitors &rarr;</button>
      </div>
    </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="scroll-fade panel p-6">
        <h3 class="text-xs font-bold text-ink-soft uppercase tracking-[0.15em] mb-4">Biggest Gainers This Week</h3>
        <div class="relative h-72 sm:h-80"><canvas id="gainers-chart"></canvas></div>
      </div>
      <div class="scroll-fade panel p-6">
        <h3 class="text-xs font-bold text-ink-soft uppercase tracking-[0.15em] mb-4">Velocity vs Volume</h3>
        <div class="relative h-72 sm:h-80"><canvas id="scatter-chart"></canvas></div>
        <p class="text-xs text-ink-mute mt-2">Top-right = high volume + high velocity. Bottom-right small dots = small base punching above weight.</p>
      </div>
    </div>
  </section>

  <!-- RAPTOR'S MOVES — three numbered visual cards, click to expand body -->
  <section data-panel="moves" class="hidden space-y-6">
    <div class="panel p-6">
      <div class="flex items-center justify-between mb-2 flex-wrap gap-2">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white">Raptor's Moves This Week</h2>
          <p class="text-ink-soft text-sm mt-1">Three concrete actions plus reasoning. Click any card to read the full breakdown.</p>
        </div>
        <span class="text-[10px] uppercase tracking-wider text-ink-soft bg-white/5 px-2 py-1 rounded border border-white/10">Live AI</span>
      </div>
    </div>

    {% if action_cards %}
    <div class="space-y-4">
      {% for card in action_cards %}
      <details class="panel overflow-hidden group" {% if loop.first %}open{% endif %}>
        <summary class="p-5 sm:p-6 hover:bg-white/5 transition-colors">
          <div class="flex items-start gap-4">
            <span class="flex-shrink-0 w-9 h-9 rounded-lg bg-white/5 border border-white/15 text-white flex items-center justify-center font-bold">{{ card.number }}</span>
            <div class="flex-1 min-w-0">
              <h3 class="text-base sm:text-lg font-bold text-white leading-snug">{{ card.headline }}</h3>
              <p class="text-xs text-accent-green mt-2 inline-flex items-center gap-1 font-semibold">
                <span class="chev inline-block">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                </span>
                <span class="when-closed">Show reasoning</span>
                <span class="when-open" style="display:none">Hide reasoning</span>
              </p>
            </div>
          </div>
        </summary>
        <div class="px-5 sm:px-6 pb-6 ai-prose text-sm border-t border-white/5 pt-4 ml-13">{{ card.body | md }}</div>
      </details>
      {% endfor %}
    </div>
    {% else %}
    <div class="panel p-6 ai-prose text-sm">{{ raptor_actions | md if raptor_actions else 'No actions synthesized this cycle.' }}</div>
    {% endif %}
  </section>

  <!-- MOVEMENT TAB — sortable table + charts -->
  <section data-panel="movement" class="hidden space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="panel p-6">
        <h3 class="text-xs font-bold text-ink-soft uppercase tracking-[0.15em] mb-4">Response Rate Comparison</h3>
        <div class="relative h-80 sm:h-96"><canvas id="response-chart"></canvas></div>
      </div>
      <div class="panel p-6">
        <h3 class="text-xs font-bold text-ink-soft uppercase tracking-[0.15em] mb-4">Share of This Week's Reviews</h3>
        <div class="relative h-80 sm:h-96"><canvas id="share-chart"></canvas></div>
      </div>
    </div>

    <div class="panel overflow-hidden">
      <div class="p-6 border-b border-white/5">
        <h3 class="text-xs font-bold text-ink-soft uppercase tracking-[0.15em]">Full Weekly Gains</h3>
        <p class="text-xs text-ink-mute mt-1">Click any column header to sort. Click any company name for the deep profile.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="data-table sortable-table">
          <thead>
            <tr>
              <th data-sort="num">#</th>
              <th data-sort="text">Company</th>
              <th class="text-right" data-sort="num">Total</th>
              <th class="text-right" data-sort="num">★</th>
              <th class="text-right" data-sort="num">7d</th>
              <th class="text-right" data-sort="num">30d</th>
              <th class="text-right" data-sort="num">90d</th>
              <th class="text-right" data-sort="num">Resp</th>
            </tr>
          </thead>
          <tbody>
            {% for biz in by_gain_7d[:30] %}
            <tr class="{% if 'raptor' in biz.name.lower() %}raptor-row{% endif %}" onclick="window.location.href='competitor/{{ biz.slug }}/'" style="cursor:pointer;">
              <td class="text-ink-soft" data-val="{{ loop.index }}">{{ loop.index }}</td>
              <td class="font-medium" data-val="{{ biz.name|lower }}">{{ biz.name }}</td>
              <td class="text-right stat-num" data-val="{{ biz.review_count }}">{{ '{:,}'.format(biz.review_count) }}</td>
              <td class="text-right" data-val="{{ biz.rating or 0 }}">{{ biz.rating if biz.rating is not none else '–' }}</td>
              <td class="text-right {% if biz.reviews_7d and biz.reviews_7d > 0 %}text-up{% else %}text-flat{% endif %}" data-val="{{ biz.reviews_7d or 0 }}">+{{ biz.reviews_7d or 0 }}</td>
              <td class="text-right" data-val="{{ biz.reviews_30d or 0 }}">+{{ biz.reviews_30d or 0 }}</td>
              <td class="text-right" data-val="{{ biz.reviews_90d or 0 }}">+{{ biz.reviews_90d or 0 }}</td>
              <td class="text-right" data-val="{{ ((biz.response_rate or 0) * 100)|int }}">{% if biz.response_rate is not none %}{{ (biz.response_rate * 100)|int }}%{% else %}–{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- NEWS TAB — cards with SVG icons; modal shows full DETAIL -->
  <section data-panel="news" class="hidden space-y-6">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-white">This Week in Roofing</h2>
        <p class="text-sm text-ink-soft mt-1">Local Indy events plus national/industry stories. Click any card for the full story and source.</p>
      </div>
    </div>

    {% if news_cards %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {% for card in news_cards %}
      <button onclick="openNews({{ loop.index0 }})" class="panel text-left p-5 hover:border-accent-green/40 hover:-translate-y-0.5 transition-all group">
        <div class="flex items-start justify-between mb-3">
          <div class="w-9 h-9 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-ink-soft" data-cat-icon="{{ card.category }}"></div>
          {% if card.when %}<span class="text-[10px] uppercase tracking-wider text-ink-mute bg-white/5 px-2 py-1 rounded">{{ card.when }}</span>{% endif %}
        </div>
        <div class="font-bold text-white text-base mb-1.5">{{ card.company }}</div>
        <div class="text-sm text-ink-soft line-clamp-3">{{ card.event }}</div>
        <div class="mt-3 flex items-center gap-1 text-xs font-semibold text-accent-green group-hover:text-white">
          Read full story
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </div>
      </button>
      {% endfor %}
    </div>

    <div id="news-modal" class="fixed inset-0 z-50 hidden">
      <div class="absolute inset-0 bg-navy-darker/85 backdrop-blur-sm" onclick="closeNews()"></div>
      <div class="relative max-w-2xl mx-auto mt-12 mb-12 panel-hero overflow-hidden">
        <div class="bg-gradient-to-br from-navy-deep to-navy text-white p-6 relative border-b border-white/10">
          <button onclick="closeNews()" class="absolute top-4 right-4 text-white/60 hover:text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
          <div class="flex items-center gap-3 mb-2">
            <div id="news-modal-icon" class="w-10 h-10 rounded-lg bg-white/10 border border-white/15 flex items-center justify-center text-accent-green"></div>
            <p id="news-modal-when" class="text-ink-soft text-xs uppercase tracking-wider"></p>
          </div>
          <h3 id="news-modal-company" class="text-xl font-bold mt-2"></h3>
        </div>
        <div class="p-6 space-y-5 max-h-[60vh] overflow-y-auto">
          <div>
            <div class="text-[10px] uppercase tracking-wider text-ink-soft mb-1">What happened</div>
            <p id="news-modal-event" class="text-sm text-white"></p>
          </div>
          <div>
            <div class="text-[10px] uppercase tracking-wider text-accent-green mb-1">Why it matters for Raptor</div>
            <p id="news-modal-why" class="text-sm text-white"></p>
          </div>
          <div id="news-modal-detail-wrap">
            <div class="text-[10px] uppercase tracking-wider text-ink-soft mb-1">Full breakdown</div>
            <p id="news-modal-detail" class="text-sm text-ink-soft leading-relaxed"></p>
          </div>
          <a id="news-modal-source" href="#" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-sm font-semibold text-accent-green hover:text-white">
            View source
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>
    </div>
    <script>window.NEWS_CARDS = {{ news_cards | tojson }};</script>
    {% else %}
    <div class="panel p-8 text-center text-ink-soft">No significant market news this cycle.</div>
    {% endif %}
  </section>

  <!-- RISING — structured 4-block layout per profile -->
  <section data-panel="rising" class="hidden space-y-6">
    {% if rising_profiles %}
    <div class="space-y-6">
      {% for rp in rising_profiles %}
      <div class="scroll-fade panel overflow-hidden">
        <div class="p-5 sm:p-6 border-b border-white/5">
          <div class="flex items-start justify-between flex-wrap gap-3">
            <div>
              <h3 class="text-lg sm:text-xl font-bold text-white">{{ rp.competitor.name }}</h3>
              <div class="flex items-center gap-2 mt-2 flex-wrap text-xs text-ink-soft">
                <span class="px-2 py-0.5 bg-accent-green/10 text-accent-green rounded font-bold uppercase tracking-wide border border-accent-green/30">+{{ rp.competitor.reviews_7d or 0 }} 7d</span>
                <span>·</span><span>{{ rp.competitor.review_count }} total reviews</span>
                <span>·</span><span>{{ rp.competitor.rating }}★</span>
                <span>·</span><span>+{{ rp.competitor.reviews_30d or 0 }} in 30d</span>
              </div>
            </div>
          </div>
        </div>
        {% if rp.fields and (rp.fields.who or rp.fields.driving or rp.fields.steal or rp.fields.weakness) %}
        <div class="grid grid-cols-1 md:grid-cols-2 divide-x divide-white/5 divide-y divide-white/5">
          {% if rp.fields.who %}
          <div class="p-5 sm:p-6">
            <div class="text-[10px] uppercase tracking-wider text-ink-mute mb-2">Who they are</div>
            <div class="ai-prose text-sm">{{ rp.fields.who | md }}</div>
          </div>
          {% endif %}
          {% if rp.fields.driving %}
          <div class="p-5 sm:p-6">
            <div class="text-[10px] uppercase tracking-wider text-accent-green mb-2">What's driving them</div>
            <div class="ai-prose text-sm">{{ rp.fields.driving | md }}</div>
          </div>
          {% endif %}
          {% if rp.fields.steal %}
          <div class="p-5 sm:p-6">
            <div class="text-[10px] uppercase tracking-wider text-accent-blue mb-2">Tactic to steal</div>
            <div class="ai-prose text-sm">{{ rp.fields.steal | md }}</div>
          </div>
          {% endif %}
          {% if rp.fields.weakness %}
          <div class="p-5 sm:p-6">
            <div class="text-[10px] uppercase tracking-wider text-amber-400 mb-2">Their weakness</div>
            <div class="ai-prose text-sm">{{ rp.fields.weakness | md }}</div>
          </div>
          {% endif %}
        </div>
        {% else %}
        <div class="p-5 sm:p-6 ai-prose text-sm">{{ rp.profile | md }}</div>
        {% endif %}
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="panel p-8 text-center text-ink-soft">No rising players flagged this cycle.</div>
    {% endif %}

    {% if red_team %}
    <div class="panel p-6 sm:p-8 mt-6">
      <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
        <h2 class="text-lg sm:text-xl font-bold text-white">Red-Team Memo</h2>
        <span class="text-[10px] uppercase tracking-wider text-accent-green bg-accent-green/10 border border-accent-green/30 px-2 py-1 rounded">AI plays {{ red_team.competitor.name }}'s CMO</span>
      </div>
      <p class="text-xs text-ink-soft mb-4">If they were attacking you this quarter, here's what they'd do.</p>
      <div class="ai-prose text-sm sm:text-base">{{ red_team.memo | md }}</div>
    </div>
    {% endif %}
  </section>

  <!-- SEO + AEO — section-by-section visual cards -->
  <section data-panel="seo" class="hidden space-y-6">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-white">SEO + AEO Intelligence</h2>
        <p class="text-sm text-ink-soft mt-1">Where competitors win on search and generative AI engines, what tactic Raptor should run this week, where Raptor stands when ChatGPT, Claude, and Gemini are asked about Indy roofing.</p>
      </div>
    </div>

    {% if seo_sections %}
    <div class="space-y-4">
      {% for sec in seo_sections %}
      <details class="panel overflow-hidden group" {% if loop.first %}open{% endif %}>
        <summary class="p-5 sm:p-6 hover:bg-white/5 transition-colors">
          <div class="flex items-start justify-between gap-3">
            <div class="flex-1 min-w-0">
              <div class="text-[10px] uppercase tracking-wider text-ink-mute mb-1">Section {{ loop.index }}</div>
              <h3 class="text-base sm:text-lg font-bold text-white leading-snug">{{ sec.heading }}</h3>
            </div>
            <svg class="chev w-5 h-5 text-ink-soft flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
        </summary>
        <div class="px-5 sm:px-6 pb-6 ai-prose text-sm border-t border-white/5 pt-4">{{ sec.body | md }}</div>
      </details>
      {% endfor %}
    </div>
    {% else %}
    <div class="panel p-8 text-center text-ink-soft">SEO + AEO brief will populate on the next refresh cycle.</div>
    {% endif %}
  </section>

  <!-- ALL COMPETITORS — sortable -->
  <section data-panel="all" class="hidden space-y-6">
    <div class="panel overflow-hidden">
      <div class="p-6 border-b border-white/5 flex items-center justify-between flex-wrap gap-2">
        <div>
          <h3 class="text-xs font-bold text-ink-soft uppercase tracking-[0.15em]">All Tracked Competitors</h3>
          <p class="text-xs text-ink-mute mt-1">Top 50 by review volume. Click any column header to sort. Click any name for the deep profile.</p>
        </div>
        <span class="text-[10px] uppercase tracking-wider text-ink-soft bg-white/5 px-2 py-1 rounded border border-white/10">{{ by_volume | length }} tracked</span>
      </div>
      <div class="overflow-x-auto">
        <table class="data-table sortable-table">
          <thead>
            <tr>
              <th data-sort="num">#</th>
              <th data-sort="text">Company</th>
              <th class="text-right" data-sort="num">Total</th>
              <th class="text-right" data-sort="num">★</th>
              <th class="text-right" data-sort="num">7d</th>
              <th class="text-right" data-sort="num">30d</th>
              <th class="text-right" data-sort="num">90d</th>
              <th class="text-right" data-sort="num">Resp</th>
            </tr>
          </thead>
          <tbody>
            {% for biz in by_volume[:50] %}
            <tr onclick="window.location.href='competitor/{{ biz.slug }}/'" class="{% if 'raptor' in biz.name.lower() %}raptor-row{% endif %} group" style="cursor:pointer;">
              <td class="text-ink-soft" data-val="{{ loop.index }}">{{ loop.index }}</td>
              <td class="font-medium" data-val="{{ biz.name|lower }}">
                <a href="competitor/{{ biz.slug }}/" class="hover:text-accent-green transition-colors group-hover:underline">{{ biz.name }}</a>
              </td>
              <td class="text-right stat-num" data-val="{{ biz.review_count }}">{{ '{:,}'.format(biz.review_count) }}</td>
              <td class="text-right" data-val="{{ biz.rating or 0 }}">{{ biz.rating if biz.rating is not none else '–' }}</td>
              <td class="text-right {% if biz.reviews_7d and biz.reviews_7d > 0 %}text-up{% else %}text-flat{% endif %}" data-val="{{ biz.reviews_7d or 0 }}">+{{ biz.reviews_7d or 0 }}</td>
              <td class="text-right" data-val="{{ biz.reviews_30d or 0 }}">+{{ biz.reviews_30d or 0 }}</td>
              <td class="text-right" data-val="{{ biz.reviews_90d or 0 }}">+{{ biz.reviews_90d or 0 }}</td>
              <td class="text-right" data-val="{{ ((biz.response_rate or 0) * 100)|int }}">{% if biz.response_rate is not none %}{{ (biz.response_rate * 100)|int }}%{% else %}–{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>

</main>

<!-- Mobile Bottom Tab Bar -->
