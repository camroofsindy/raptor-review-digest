<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Raptor Review Digest | {{ run_date }}</title>
<meta name="description" content="Weekly competitive intelligence for Raptor Roofing in Indianapolis.">
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ccircle cx='50' cy='50' r='45' fill='%23172e55'/%3E%3Ctext x='50' y='62' font-size='40' text-anchor='middle' fill='%233ae20a' font-family='sans-serif' font-weight='700'%3ER%3C/text%3E%3C/svg%3E">

<script src="https://cdn.tailwindcss.com"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0"></script>
<script>
tailwind.config = {
  theme: {
    extend: {
      colors: {
        navy: { 50: '#e8ecf3', 100: '#c4cee0', 200: '#7d92ba', 300: '#4a679a', DEFAULT: '#172e55', deep: '#0d1d3a', darker: '#08142a', light: '#2a4880' },
        accent: { green: '#3ae20a', blue: '#1ac6ff' },
        ink: { DEFAULT: '#ffffff', soft: '#a3b1c7', mute: '#6b7d99', dim: '#4a5878' },
      },
      fontFamily: { sans: ['Ouma Latin VF', 'Inter', 'Helvetica Neue', 'Helvetica', 'Arial', 'sans-serif'] },
    },
  },
};
</script>
<style>
  body { font-feature-settings: "ss01", "ss02"; background-color: #08142a; }
  .stat-num { font-variant-numeric: tabular-nums; }
  .scroll-fade { opacity: 0; transform: translateY(20px); transition: opacity 0.7s cubic-bezier(0.16, 1, 0.3, 1), transform 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  .scroll-fade.visible { opacity: 1; transform: translateY(0); }
  .tab-active { background: linear-gradient(135deg, #3ae20a 0%, #1ac6ff 100%); color: #0d1d3a !important; box-shadow: 0 4px 14px rgba(58,226,10,0.35); }
  .tab-active span { color: #0d1d3a; }
  .tab-active svg { opacity: 1 !important; color: #0d1d3a; }
  details > summary { list-style: none; cursor: pointer; }
  details > summary::-webkit-details-marker { display: none; }
  details[open] > summary .chev { transform: rotate(90deg); }
  .chev { transition: transform 0.2s ease; }

  /* Card system: dark navy with depth and glow */
  .panel {
    background: linear-gradient(180deg, rgba(22, 46, 85, 0.65) 0%, rgba(13, 29, 58, 0.85) 100%);
    border: 1px solid rgba(58, 226, 10, 0.08);
    border-radius: 16px;
    backdrop-filter: blur(8px);
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.25), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    position: relative;
    overflow: hidden;
  }
  .panel::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
    background: linear-gradient(90deg, transparent, rgba(58, 226, 10, 0.3), transparent);
  }
  .panel-hero {
    background: linear-gradient(135deg, rgba(22, 46, 85, 0.95) 0%, rgba(13, 29, 58, 0.95) 100%);
    border: 1px solid rgba(58, 226, 10, 0.2);
    border-radius: 16px;
    box-shadow: 0 8px 40px rgba(58, 226, 10, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    position: relative;
    overflow: hidden;
  }
  .panel-hero::after {
    content: ''; position: absolute; top: -50%; right: -30%; width: 70%; height: 200%;
    background: radial-gradient(circle, rgba(26, 198, 255, 0.06), transparent 60%);
    pointer-events: none;
  }

  /* AI prose on dark background */
  .ai-prose { color: rgba(255, 255, 255, 0.92); }
  .ai-prose h1, .ai-prose h2, .ai-prose h3, .ai-prose h4 { color: #ffffff; font-weight: 700; margin: 1.2em 0 0.5em; line-height: 1.25; }
  .ai-prose h1 { font-size: 1.35rem; color: #3ae20a; }
  .ai-prose h2 { font-size: 1.15rem; color: #3ae20a; padding-top: 0.5em; border-top: 1px solid rgba(58, 226, 10, 0.2); }
  .ai-prose h2:first-child { border-top: none; padding-top: 0; }
  .ai-prose h3 { font-size: 1rem; color: #1ac6ff; }
  .ai-prose h4 { font-size: 0.85rem; color: #a3b1c7; text-transform: uppercase; letter-spacing: 0.05em; }
  .ai-prose p { margin: 0.7em 0; line-height: 1.65; }
  .ai-prose strong { color: #ffffff; font-weight: 700; }
  .ai-prose em { color: #a3b1c7; font-style: italic; }
  .ai-prose ul, .ai-prose ol { padding-left: 1.4em; margin: 0.6em 0; }
  .ai-prose li { margin: 0.4em 0; line-height: 1.6; }
  .ai-prose a { color: #1ac6ff; border-bottom: 1px solid rgba(26, 198, 255, 0.4); transition: border-color 0.15s; }
  .ai-prose a:hover { border-color: #1ac6ff; color: #ffffff; }
  .ai-prose hr { border: none; border-top: 1px solid rgba(255, 255, 255, 0.1); margin: 1.5em 0; }

  .gradient-text { background: linear-gradient(135deg, #3ae20a 0%, #1ac6ff 100%); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
  .line-clamp-3 { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .no-scrollbar::-webkit-scrollbar { display: none; }
  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

  /* Table styling on dark */
  .data-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .data-table thead th { text-align: left; padding: 12px 10px; background: rgba(13, 29, 58, 0.6); border-bottom: 2px solid rgba(58, 226, 10, 0.4); font-weight: 700; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase; color: #3ae20a; }
  .data-table tbody td { padding: 12px 10px; border-bottom: 1px solid rgba(255, 255, 255, 0.06); vertical-align: top; color: rgba(255, 255, 255, 0.85); }
  .data-table tbody tr:hover { background: rgba(58, 226, 10, 0.04); }
  .data-table tbody tr.raptor-row { background: rgba(58, 226, 10, 0.08); border-left: 3px solid #3ae20a; }
  .data-table tbody tr.raptor-row td { color: #ffffff; font-weight: 600; }
  .text-up { color: #3ae20a; font-weight: 700; }
  .text-flat { color: #6b7d99; }
</style>
</head>
<body class="text-white antialiased min-h-screen">

<!-- Subtle ambient gradient overlay across page -->
<div class="fixed inset-0 pointer-events-none" style="background-image: radial-gradient(circle at 15% 0%, rgba(58, 226, 10, 0.06) 0%, transparent 40%), radial-gradient(circle at 85% 50%, rgba(26, 198, 255, 0.05) 0%, transparent 35%);"></div>

<!-- Hero -->
<section class="relative z-10">
  <div class="max-w-6xl mx-auto px-5 sm:px-8 pt-8 pb-10">
    <div class="flex items-center justify-between mb-8 flex-wrap gap-4">
      <div class="flex items-center gap-3">
        <img src="assets/logo.webp" alt="Raptor Roofing" class="h-12 sm:h-14 w-auto" onerror="this.style.display='none'">
      </div>
      <div class="text-right">
        <div class="text-[10px] tracking-[0.2em] uppercase text-ink-soft">Last Updated</div>
        <div class="text-sm font-semibold text-white">{{ run_date }}</div>
      </div>
    </div>
    <h1 class="text-3xl sm:text-5xl font-bold tracking-tight mb-3 leading-tight">Indianapolis roofing,<br><span class="gradient-text">moved this week.</span></h1>
    <p class="text-ink-soft text-sm sm:text-base max-w-2xl">Live competitive intel scraped from Google Maps, paired with web research from Claude. Refreshed Tuesday and Thursday at 7:30am Eastern.</p>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-8">
      {% for stat in [('+' ~ (raptor.reviews_7d if raptor else 0)|string, 'Raptor 7 Days', 'green'),
                       ('+' ~ (raptor.reviews_30d if raptor else 0)|string, 'Raptor 30 Days', 'green'),
                       ('#' ~ (raptor_rank or 'n/a')|string, 'Volume Rank', 'blue'),
                       (((raptor.response_rate * 100)|int|string ~ '%') if raptor and raptor.response_rate else '–', 'Response Rate', 'blue')] %}
      <div class="panel p-4">
        <div class="text-3xl sm:text-4xl font-bold stat-num {% if stat[2] == 'green' %}text-accent-green{% else %}text-accent-blue{% endif %}">{{ stat[0] }}</div>
        <div class="text-[10px] tracking-widest uppercase text-ink-soft mt-1">{{ stat[1] }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Sticky Tab Nav -->
<nav class="sticky top-0 z-30 bg-navy-darker/95 backdrop-blur-xl border-b border-accent-green/15 shadow-lg">
  <div class="max-w-6xl mx-auto px-3 sm:px-6">
    <div class="flex gap-1 sm:gap-2 overflow-x-auto no-scrollbar py-2">
      {% for tab in [('overview', 'Overview', 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6'), ('moves', "Raptor's Moves", 'M13 10V3L4 14h7v7l9-11h-7z'), ('movement', 'Movement', 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6'), ('news', 'News', 'M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z'), ('rising', 'Rising', 'M13 7h8m0 0v8m0-8l-8 8-4-4-6 6'), ('seo', 'SEO + AEO', 'M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z'), ('all', 'All Competitors', 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z')] %}
      <button data-tab="{{ tab[0] }}" class="tab-btn group whitespace-nowrap inline-flex items-center gap-2 px-3 sm:px-4 py-2.5 text-xs sm:text-sm font-semibold rounded-full text-white/60 hover:text-white hover:bg-white/5 transition-all">
        <svg class="w-4 h-4 opacity-70 group-hover:opacity-100" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="{{ tab[2] }}"/></svg>
        <span>{{ tab[1] }}</span>
      </button>
      {% endfor %}
    </div>
  </div>
</nav>

<main class="relative z-10 max-w-6xl mx-auto px-5 sm:px-8 py-8 space-y-6">

  <!-- OVERVIEW TAB — short headlines + charts -->
  <section data-panel="overview" class="space-y-6">
    {% if action_headlines %}
    <div class="scroll-fade panel-hero p-6 sm:p-8">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-base sm:text-lg font-bold text-white uppercase tracking-wider">This Week's Three Moves</h2>
        <span class="text-[10px] uppercase tracking-wider text-accent-green bg-accent-green/15 border border-accent-green/30 px-2 py-1 rounded-full">CMO Briefing</span>
      </div>
      <ol class="space-y-4">
        {% for headline in action_headlines %}
        <li class="flex gap-3 text-base sm:text-lg leading-snug">
          <span class="flex-shrink-0 w-7 h-7 rounded-full bg-accent-green/20 border border-accent-green/40 text-accent-green flex items-center justify-center text-xs font-bold">{{ loop.index }}</span>
          <span class="text-white font-medium">{{ headline | replace(loop.index|string ~ '.', '') | trim }}</span>
        </li>
        {% endfor %}
      </ol>
      <button data-tab-link="moves" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-accent-green hover:text-accent-blue transition-colors">
        See full breakdown with reasoning
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </button>
    </div>
    {% endif %}

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      <div class="scroll-fade panel p-6">
        <h3 class="text-xs font-bold text-accent-green uppercase tracking-[0.15em] mb-4">Biggest Gainers This Week</h3>
        <div class="relative h-72 sm:h-80"><canvas id="gainers-chart"></canvas></div>
      </div>
      <div class="scroll-fade panel p-6">
        <h3 class="text-xs font-bold text-accent-green uppercase tracking-[0.15em] mb-4">Velocity vs Volume</h3>
        <div class="relative h-72 sm:h-80"><canvas id="scatter-chart"></canvas></div>
        <p class="text-xs text-ink-soft mt-2">Top-right = high volume + high velocity. Bottom-right small dots = small base punching above weight.</p>
      </div>
    </div>
  </section>

  <!-- RAPTOR'S MOVES TAB — full breakdown with reasoning -->
  <section data-panel="moves" class="hidden space-y-6">
    <div class="panel-hero p-6 sm:p-8">
      <div class="flex items-center justify-between mb-2 flex-wrap gap-2">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-white">Raptor's Moves This Week</h2>
          <p class="text-ink-soft text-sm mt-1">Specific actions and reasoning, written by the AI as if it were a $500K/yr CMO.</p>
        </div>
        <span class="text-[10px] uppercase tracking-wider text-accent-green bg-accent-green/15 border border-accent-green/30 px-2 py-1 rounded-full">CMO Briefing</span>
      </div>
      <div class="ai-prose text-sm sm:text-base mt-4">{{ raptor_actions | md if raptor_actions else 'No actions synthesized this cycle.' }}</div>
    </div>
  </section>

  <!-- MOVEMENT TAB -->
  <section data-panel="movement" class="hidden space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="panel p-6">
        <h3 class="text-xs font-bold text-accent-green uppercase tracking-[0.15em] mb-4">Response Rate Comparison</h3>
        <div class="relative h-80 sm:h-96"><canvas id="response-chart"></canvas></div>
        <p class="text-xs text-ink-soft mt-2">Percent of reviews each competitor has replied to. Google factors engagement into local rankings.</p>
      </div>
      <div class="panel p-6">
        <h3 class="text-xs font-bold text-accent-green uppercase tracking-[0.15em] mb-4">Share of This Week's Reviews</h3>
        <div class="relative h-80 sm:h-96"><canvas id="share-chart"></canvas></div>
        <p class="text-xs text-ink-soft mt-2">Of all new reviews captured by tracked competitors this week, who got what slice.</p>
      </div>
    </div>

    <div class="panel overflow-hidden">
      <div class="p-6 border-b border-white/5">
        <h3 class="text-xs font-bold text-accent-green uppercase tracking-[0.15em]">Full Weekly Gains</h3>
        <p class="text-xs text-ink-soft mt-1">Sortable. Click any company name to open its profile.</p>
      </div>
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead>
            <tr><th>#</th><th>Company</th><th class="text-right">Total</th><th class="text-right">★</th><th class="text-right">7d</th><th class="text-right">30d</th><th class="text-right">90d</th><th class="text-right">Resp</th></tr>
          </thead>
          <tbody>
            {% for biz in by_gain_7d[:30] %}
            <tr class="{% if 'raptor' in biz.name.lower() %}raptor-row{% endif %}" onclick="window.location.href='competitor/{{ biz.slug }}/'" style="cursor:pointer;">
              <td class="text-ink-soft">{{ loop.index }}</td>
              <td class="font-medium">{{ biz.name }}</td>
              <td class="text-right stat-num">{{ '{:,}'.format(biz.review_count) }}</td>
              <td class="text-right">{{ biz.rating if biz.rating is not none else '–' }}</td>
              <td class="text-right {% if biz.reviews_7d and biz.reviews_7d > 0 %}text-up{% else %}text-flat{% endif %}">+{{ biz.reviews_7d or 0 }}</td>
              <td class="text-right">+{{ biz.reviews_30d or 0 }}</td>
              <td class="text-right">+{{ biz.reviews_90d or 0 }}</td>
              <td class="text-right">{% if biz.response_rate is not none %}{{ (biz.response_rate * 100)|int }}%{% else %}–{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- NEWS TAB — grid of cards with modal -->
  <section data-panel="news" class="hidden space-y-6">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-white">This Week in Roofing</h2>
        <p class="text-sm text-ink-soft mt-1">Local Indy roofing events plus national/industry news that matters. Click any card for the full story.</p>
      </div>
      <span class="text-[10px] uppercase tracking-wider text-accent-green bg-accent-green/15 border border-accent-green/30 px-2 py-1 rounded-full">CMO Web Sweep</span>
    </div>

    {% if news_cards %}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {% for card in news_cards %}
      <button onclick="openNews({{ loop.index0 }})" class="panel text-left p-5 hover:border-accent-green/40 hover:-translate-y-0.5 transition-all group">
        <div class="flex items-start justify-between mb-3">
          <span class="text-2xl">{{ card.icon }}</span>
          {% if card.when %}<span class="text-[10px] uppercase tracking-wider text-ink-soft bg-white/5 px-2 py-1 rounded">{{ card.when }}</span>{% endif %}
        </div>
        <div class="font-bold text-white text-base mb-1.5">{{ card.company }}</div>
        <div class="text-sm text-ink-soft line-clamp-3">{{ card.event }}</div>
        <div class="mt-3 flex items-center gap-1 text-xs font-semibold text-accent-blue group-hover:text-accent-green">
          Read full story
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </div>
      </button>
      {% endfor %}
    </div>

    <div id="news-modal" class="fixed inset-0 z-50 hidden">
      <div class="absolute inset-0 bg-navy-darker/85 backdrop-blur-sm" onclick="closeNews()"></div>
      <div class="relative max-w-2xl mx-auto mt-12 mb-12 panel-hero overflow-hidden animate-fade-up">
        <div class="bg-gradient-to-br from-navy-deep to-navy text-white p-6 relative border-b border-accent-green/20">
          <button onclick="closeNews()" class="absolute top-4 right-4 text-white/70 hover:text-white">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
          </button>
          <div id="news-modal-icon" class="text-3xl mb-2"></div>
          <h3 id="news-modal-company" class="text-xl font-bold"></h3>
          <p id="news-modal-when" class="text-ink-soft text-xs mt-1 uppercase tracking-wider"></p>
        </div>
        <div class="p-6 space-y-4">
          <div>
            <div class="text-[10px] uppercase tracking-wider text-accent-green mb-1">What happened</div>
            <p id="news-modal-event" class="text-sm text-white"></p>
          </div>
          <div class="bg-accent-green/10 border-l-4 border-accent-green p-4 rounded">
            <div class="text-[10px] uppercase tracking-wider text-accent-green mb-1">Why it matters for Raptor</div>
            <p id="news-modal-why" class="text-sm text-white"></p>
          </div>
          <a id="news-modal-source" href="#" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-sm font-semibold text-accent-blue hover:text-accent-green">
            View source
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </a>
        </div>
      </div>
    </div>
    <script>window.NEWS_CARDS = {{ news_cards | tojson }};</script>
    {% else %}
    <div class="panel p-8 text-center text-ink-soft">No significant market news this cycle.</div>
    {% endif %}
  </section>

  <!-- RISING PLAYERS TAB -->
  <section data-panel="rising" class="hidden space-y-6">
    {% if rising_profiles %}
    {% for rp in rising_profiles %}
    <details class="scroll-fade panel overflow-hidden group" {% if loop.first %}open{% endif %}>
      <summary class="p-5 sm:p-6 flex items-center justify-between hover:bg-white/5 transition-colors">
        <div class="flex-1 min-w-0">
          <div class="flex items-center gap-3 flex-wrap">
            <h3 class="text-base sm:text-lg font-bold text-white">{{ rp.competitor.name }}</h3>
            <span class="text-xs px-2 py-0.5 bg-accent-green/15 text-accent-green rounded-full font-semibold uppercase tracking-wide border border-accent-green/30">+{{ rp.competitor.reviews_7d or 0 }} this week</span>
          </div>
          <div class="text-xs text-ink-soft mt-1">{{ rp.competitor.review_count }} reviews · {{ rp.competitor.rating }} stars · +{{ rp.competitor.reviews_30d or 0 }} in 30 days</div>
        </div>
        <svg class="chev w-5 h-5 text-ink-soft flex-shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </summary>
      <div class="px-5 sm:px-6 pb-6 ai-prose text-sm border-t border-white/5 pt-5">{{ rp.profile | md }}</div>
    </details>
    {% endfor %}
    {% else %}
    <div class="panel p-8 text-center text-ink-soft">No rising players flagged this cycle.</div>
    {% endif %}
  </section>

  <!-- SEO + AEO TAB -->
  <section data-panel="seo" class="hidden space-y-6">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <div>
        <h2 class="text-lg sm:text-xl font-bold text-white">SEO + AEO Intelligence</h2>
        <p class="text-sm text-ink-soft mt-1">Where competitors win on search and generative AI engines, what tactic Raptor should run this week, where Raptor stands when ChatGPT/Claude/Gemini are asked about Indy roofing.</p>
      </div>
      <span class="text-[10px] uppercase tracking-wider text-accent-green bg-accent-green/15 border border-accent-green/30 px-2 py-1 rounded-full">CMO Briefing</span>
    </div>
    <div class="panel-hero p-6 sm:p-8">
      <div class="ai-prose text-sm sm:text-base">{{ seo_aeo_brief | md if seo_aeo_brief else 'SEO + AEO brief will populate on the next refresh cycle.' }}</div>
    </div>
  </section>

  <!-- ALL COMPETITORS TAB — top 50 with click-through to sub-page -->
  <section data-panel="all" class="hidden space-y-6">
    <div class="panel overflow-hidden">
      <div class="p-6 border-b border-white/5 flex items-center justify-between flex-wrap gap-2">
        <div>
          <h3 class="text-xs font-bold text-accent-green uppercase tracking-[0.15em]">All Tracked Competitors</h3>
          <p class="text-xs text-ink-soft mt-1">Top 50 by review volume. Click any name for a deep CMO-grade profile.</p>
        </div>
        <span class="text-[10px] uppercase tracking-wider text-ink-soft bg-white/5 px-2 py-1 rounded">{{ by_volume | length }} tracked</span>
      </div>
      <div class="overflow-x-auto">
        <table class="data-table">
          <thead>
            <tr><th>#</th><th>Company</th><th class="text-right">Total</th><th class="text-right">★</th><th class="text-right">7d</th><th class="text-right">30d</th><th class="text-right">90d</th><th class="text-right">Resp</th></tr>
          </thead>
          <tbody>
            {% for biz in by_volume[:50] %}
            <tr onclick="window.location.href='competitor/{{ biz.slug }}/'" class="{% if 'raptor' in biz.name.lower() %}raptor-row{% endif %} group" style="cursor:pointer;">
              <td class="text-ink-soft">{{ loop.index }}</td>
              <td class="font-medium">
                <a href="competitor/{{ biz.slug }}/" class="hover:text-accent-blue transition-colors group-hover:underline">{{ biz.name }} <svg class="inline w-3 h-3 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
              </td>
              <td class="text-right stat-num">{{ '{:,}'.format(biz.review_count) }}</td>
              <td class="text-right">{{ biz.rating if biz.rating is not none else '–' }}</td>
              <td class="text-right {% if biz.reviews_7d and biz.reviews_7d > 0 %}text-up{% else %}text-flat{% endif %}">+{{ biz.reviews_7d or 0 }}</td>
              <td class="text-right">+{{ biz.reviews_30d or 0 }}</td>
              <td class="text-right">+{{ biz.reviews_90d or 0 }}</td>
              <td class="text-right">{% if biz.response_rate is not none %}{{ (biz.response_rate * 100)|int }}%{% else %}–{% endif %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </section>

</main>

<footer class="relative z-10 max-w-6xl mx-auto px-5 sm:px-8 py-10 mt-8 border-t border-white/5">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs text-ink-soft">
    <div>
      <div class="font-semibold text-white">Raptor Roofing | Review Digest</div>
      <div>5145 S. Meridian St., Suite B · Indianapolis, IN 46217 · 317.886.0696</div>
    </div>
    <div class="text-right">
      <div>Generated {{ run_date }}</div>
      <div>Refreshed Tuesdays and Thursdays at 7:30am Eastern</div>
    </div>
  </div>
</footer>

<script>
const tabs = document.querySelectorAll('.tab-btn');
const panels = document.querySelectorAll('[data-panel]');
function showTab(name) {
  tabs.forEach(t => t.classList.toggle('tab-active', t.dataset.tab === name));
  panels.forEach(p => p.classList.toggle('hidden', p.dataset.panel !== name));
  window.scrollTo({ top: 0, behavior: 'smooth' });
}
tabs.forEach(t => t.addEventListener('click', () => showTab(t.dataset.tab)));
document.querySelectorAll('[data-tab-link]').forEach(b => b.addEventListener('click', () => showTab(b.dataset.tabLink)));
showTab('overview');

const observer = new IntersectionObserver((entries) => { entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); }); }, { threshold: 0.1 });
document.querySelectorAll('.scroll-fade').forEach(el => observer.observe(el));

function openNews(idx) {
  const card = (window.NEWS_CARDS || [])[idx];
  if (!card) return;
  document.getElementById('news-modal-icon').textContent = card.icon || '📌';
  document.getElementById('news-modal-company').textContent = card.company || '';
  document.getElementById('news-modal-when').textContent = card.when || '';
  document.getElementById('news-modal-event').textContent = card.event || '';
  document.getElementById('news-modal-why').textContent = card.why_matters || card.why || '';
  const src = document.getElementById('news-modal-source');
  if (card.source && card.source.startsWith('http')) {
    src.href = card.source; src.style.display = 'inline-flex';
  } else { src.style.display = 'none'; }
  document.getElementById('news-modal').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}
function closeNews() {
  document.getElementById('news-modal').classList.add('hidden');
  document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeNews(); });

const DATA = {{ chart_data | tojson }};
const NAVY = '#172e55';
const GREEN = '#3ae20a';
const BLUE = '#1ac6ff';
const NAVY_LIGHT = '#2a4880';
const SOFT = 'rgba(255,255,255,0.08)';
const TEXT_SOFT = '#a3b1c7';

Chart.defaults.font.family = "'Ouma Latin VF', 'Inter', 'Helvetica Neue', Helvetica, Arial, sans-serif";
Chart.defaults.color = TEXT_SOFT;
Chart.defaults.borderColor = SOFT;

// Gainers bar with value labels on top
new Chart(document.getElementById('gainers-chart'), {
  type: 'bar',
  data: {
    labels: DATA.gainers.map(g => g.name),
    datasets: [{
      data: DATA.gainers.map(g => g.gain_7d),
      backgroundColor: DATA.gainers.map(g => g.is_raptor ? GREEN : BLUE),
      borderRadius: 6,
    }],
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    layout: { padding: { top: 24 } },
    plugins: {
      legend: { display: false },
      tooltip: { backgroundColor: '#0d1d3a', borderColor: GREEN, borderWidth: 1, titleColor: GREEN, bodyColor: '#fff' },
    },
    scales: {
      x: { ticks: { color: TEXT_SOFT, autoSkip: false, maxRotation: 45, minRotation: 35 }, grid: { display: false } },
      y: { beginAtZero: true, grid: { color: SOFT }, ticks: { precision: 0, color: TEXT_SOFT } },
    },
    animation: {
      onComplete: function() {
        const chart = this; const ctx = chart.ctx;
        ctx.font = "bold 11px 'Inter', sans-serif"; ctx.fillStyle = '#ffffff'; ctx.textAlign = 'center';
        chart.data.datasets[0].data.forEach((v, i) => {
          const meta = chart.getDatasetMeta(0); const bar = meta.data[i];
          ctx.fillText('+' + v, bar.x, bar.y - 6);
        });
      },
    },
  },
});

// Velocity scatter — smaller Raptor dot
new Chart(document.getElementById('scatter-chart'), {
  type: 'scatter',
  data: {
    datasets: DATA.scatter.map(p => ({
      label: p.name,
      data: [{ x: p.total, y: p.gain_7d }],
      backgroundColor: p.is_raptor ? GREEN : (p.gain_7d > 5 ? BLUE : NAVY_LIGHT),
      pointRadius: p.is_raptor ? 7 : 5,
      pointHoverRadius: p.is_raptor ? 10 : 8,
      pointBorderColor: p.is_raptor ? '#ffffff' : 'transparent',
      pointBorderWidth: p.is_raptor ? 2 : 0,
    })),
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { display: false },
      tooltip: { backgroundColor: '#0d1d3a', borderColor: GREEN, borderWidth: 1, titleColor: GREEN, bodyColor: '#fff', callbacks: { label: (ctx) => `${ctx.dataset.label}: ${ctx.parsed.x.toLocaleString()} total, +${ctx.parsed.y} this week` } },
    },
    scales: {
      x: { type: 'logarithmic', title: { display: true, text: 'Total Reviews (log)', color: TEXT_SOFT }, grid: { color: SOFT }, ticks: { color: TEXT_SOFT } },
      y: { beginAtZero: true, title: { display: true, text: 'Reviews this week', color: TEXT_SOFT }, grid: { color: SOFT }, ticks: { color: TEXT_SOFT } },
    },
  },
});

new Chart(document.getElementById('response-chart'), {
  type: 'bar',
  data: {
    labels: DATA.response.map(r => r.name),
    datasets: [{
      data: DATA.response.map(r => r.rate),
      backgroundColor: DATA.response.map(r => r.is_raptor ? GREEN : BLUE),
      borderRadius: 4,
    }],
  },
  options: {
    indexAxis: 'y',
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { display: false }, tooltip: { backgroundColor: '#0d1d3a', borderColor: GREEN, borderWidth: 1, titleColor: GREEN, bodyColor: '#fff', callbacks: { label: (ctx) => `${ctx.parsed.x}%` } } },
    scales: {
      x: { beginAtZero: true, max: 100, grid: { color: SOFT }, ticks: { color: TEXT_SOFT, callback: (v) => v + '%' } },
      y: { grid: { display: false }, ticks: { color: TEXT_SOFT } },
    },
  },
});

new Chart(document.getElementById('share-chart'), {
  type: 'doughnut',
  data: {
    labels: DATA.share.map(s => s.name),
    datasets: [{
      data: DATA.share.map(s => s.gain),
      backgroundColor: DATA.share.map((s, i) => s.is_raptor ? GREEN : [BLUE, NAVY_LIGHT, '#5a7bb3', '#8aa1ce', '#b3c2dc', '#d4dbe6'][i % 6]),
      borderWidth: 2,
      borderColor: '#0d1d3a',
    }],
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: { legend: { position: 'right', labels: { color: TEXT_SOFT, boxWidth: 12, font: { size: 11 } } }, tooltip: { backgroundColor: '#0d1d3a', borderColor: GREEN, borderWidth: 1, titleColor: GREEN, bodyColor: '#fff' } },
    cutout: '65%',
  },
});
</script>
</body>
</html>
